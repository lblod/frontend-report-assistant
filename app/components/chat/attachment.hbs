{{! One row of the bijlagen overview: its name, what it holds, and how to
    get it. The service is synchronous per turn: a bijlage already has its
    file when the message is served. The file service serves
    /files/<uuid>/download. }}
<div class="chat-attachment chat-attachment--row au-u-margin-top-tiny">
  <div class="chat-attachment__info">
    <strong>{{@document.filename}}</strong>
    <span class="chat-attachment__what">{{this.what}}</span>
  </div>
  <a href={{this.href}} class="au-c-link" download={{@document.filename}}>
    Download
  </a>
</div>
