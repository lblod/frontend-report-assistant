<div class="au-c-sidebar">
  <div class="au-c-sidebar__header">
    <AuHeading @level="2" @skin="3">Gesprekken</AuHeading>
  </div>
  <div class="au-c-sidebar__content">
    <ul class="au-c-list-navigation chat-sidebar__list">
      {{#each @conversations as |conversation|}}
        <li class="au-c-list-navigation__item chat-sidebar__item">
          <AuNavigationLink
            @route="conversations.conversation"
            @model={{conversation.id}}
            class="chat-sidebar__link"
          >
            <span class="chat-sidebar__title">
              {{if conversation.title conversation.title "Nieuw gesprek"}}
            </span>
            <span class="chat-sidebar__meta">
              {{format-datetime conversation.lastActivity}}
            </span>
          </AuNavigationLink>
          <button
            type="button"
            class="chat-sidebar__delete"
            title="Gesprek verwijderen"
            aria-label="Gesprek verwijderen"
            {{on "click" (fn this.delete conversation)}}
          >
            <AuIcon @icon="trash" @ariaHidden="true" />
          </button>
        </li>
      {{else}}
        <li class="au-c-list-navigation__item">
          <p class="au-u-muted chat-sidebar__empty">Nog geen gesprekken.</p>
        </li>
      {{/each}}
    </ul>
    {{! The list is newest first, so the next page holds older ones. }}
    {{#if @conversations.meta.pagination.last.number}}
      <div class="chat-sidebar__paging">
        {{#if @conversations.meta.pagination.prev}}
          <AuButton
            @skin="link"
            @icon="nav-left"
            {{on
              "click"
              (fn this.showPage @conversations.meta.pagination.prev)
            }}
          >
            Nieuwere
          </AuButton>
        {{/if}}
        {{#if @conversations.meta.pagination.next}}
          <AuButton
            @skin="link"
            @icon="nav-right"
            @iconAlignment="right"
            {{on
              "click"
              (fn this.showPage @conversations.meta.pagination.next)
            }}
          >
            Oudere
          </AuButton>
        {{/if}}
      </div>
    {{/if}}
  </div>
</div>