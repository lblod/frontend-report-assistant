{{page-title "Rapportassistent"}}

<AuApp>
  <AuMainHeader @homeRoute="conversations" @appTitle="Rapportassistent">
    {{#if this.session.isAuthenticated}}
      {{#if this.currentSession.isAdmin}}
        <li class="au-c-list-horizontal__item">
          <ImpersonationMenu />
        </li>
      {{/if}}
      <li class="au-c-list-horizontal__item">
        <span class="chat-user">
          <AuIcon @icon="user" @ariaHidden="true" />
          {{this.userName}}
          {{#if this.userOrg}}
            <span class="au-u-muted">({{this.userOrg}})</span>
          {{/if}}
        </span>
      </li>
      <li class="au-c-list-horizontal__item">
        <AuButton
          @skin="link"
          @icon="logout"
          @iconAlignment="left"
          {{on "click" this.logout}}
        >
          Afmelden
        </AuButton>
      </li>
    {{/if}}
  </AuMainHeader>

  <main id="main" class="au-c-main-container">
    {{outlet}}
  </main>
</AuApp>

<AuModalContainer />